{
  "appId": "nl.jayverrijt.vrijcheckapp",
  "appName": "Teamwork Vrijcheck",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_launcher",
      "iconColor": "#3171f7",
      "presentationOptions": ["badge", "sound", "banner", "list"]
    }
  }
}

